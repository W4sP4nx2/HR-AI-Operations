{"kind":"textbox","id":"sh/mtwrmxg7","slide":2,"text":"Action without context","textPreview":"Action without context","textChars":22,"textLines":1,"bbox":[694,276,420,28]}
{"kind":"textbox","id":"sh/nu58f2hs","slide":2,"text":"A model can trigger a workflow without showing the policy or case evidence behind it.","textPreview":"A model can trigger a workflow without showing the policy or case evidence behind it.","textChars":85,"textLines":1,"bbox":[694,310,470,46]}
