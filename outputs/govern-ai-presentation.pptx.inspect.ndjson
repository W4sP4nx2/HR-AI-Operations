{"kind":"textbox","id":"sh/4ri5wbqt","slide":2,"text":"Sensitive actions need a human checkpoint—not a hidden confidence threshold.","textPreview":"Sensitive actions need a human checkpoint—not a hidden confidence threshold.","textChars":76,"textLines":1,"bbox":[694,416,470,46]}
{"kind":"shape","id":"sh/3mtozapc","slide":2,"bbox":[626,490,44,44]}
