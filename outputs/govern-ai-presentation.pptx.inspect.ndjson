{"kind":"textbox","id":"sh/yhory98z","slide":2,"text":"Inference without a record","textPreview":"Inference without a record","textChars":26,"textLines":1,"bbox":[694,488,420,28]}
{"kind":"textbox","id":"sh/zix87e9k","slide":2,"text":"If the decision is not captured with who, when, and why, it cannot be audited.","textPreview":"If the decision is not captured with who, when, and why, it cannot be audited.","textChars":78,"textLines":1,"bbox":[694,522,470,46]}
