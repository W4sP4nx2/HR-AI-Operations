# ── Core ──────────────────────────────────────────────────────────────────
LLM_PROVIDER=fireworks                   # fireworks primary | anthropic | amd_vllm
ANTHROPIC_API_KEY=                       # optional only when LLM_PROVIDER=anthropic
# CLAUDE_MODEL=claude-sonnet-4-20250514  # default; EOL 2026-06-15 — set a current
#                                        # supported model for live use (a current Haiku
#                                        # is a good cheap tier for triage classification)
FIREWORKS_API_KEY=                       # required when LLM_PROVIDER=fireworks
FIREWORKS_BASE_URL=                      # official Serverless OpenAI base: https://api.fireworks.ai/inference/v1
FIREWORKS_CONTROL_BASE_URL=              # Batch management API base; inject
FIREWORKS_ACCOUNT_ID=                    # required only for Batch submit/status
FIREWORKS_MAX_RETRIES=4                  # bounded online retries; queue cold starts separately
FIREWORKS_SESSION_AFFINITY=true          # hashed chat id improves prompt-cache locality
FIREWORKS_BATCH_TIMEOUT_SECONDS=30
FIREWORKS_BATCH_MODEL=                  # Serverless/Batch-supported model; must be allowlisted
FIREWORKS_VISION_MODEL=                   # optional; must also appear in ALLOWED_MODELS
FIREWORKS_GEMMA_MODEL=accounts/fireworks/models/gemma-4-26b-a4b-it  # DOD only; must be allowlisted
AMD_VLLM_API_KEY=                        # required when LLM_PROVIDER=amd_vllm
AMD_VLLM_BASE_URL=                       # OpenAI-compatible AMD/vLLM URL, e.g. http://amd-vllm:8000/v1
HF_TOKEN=                                # AMD Gemma only: accept its license, then inject a read token
ALLOWED_MODELS=                          # comma-separated harness allow-list
QDRANT_URL=http://localhost:6333
DATABASE_URL=sqlite:///./hr_command_center.db   # or postgresql://user:pass@host:5432/hrdb
ENVIRONMENT=development

# ── Auth / RBAC ───────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
AI_SETTINGS_ENCRYPTION_KEY=              # dedicated Fernet master secret for Settings API keys
AUTH_ENFORCE=false                       # true = require auth + enforce roles
AUTH_OPEN_REGISTRATION=true              # first registered user becomes admin
WEBHOOK_SECRET=                          # required header for inbound webhooks in prod

# ── Google OAuth (optional) ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:8000
FRONTEND_BASE=http://localhost:3000

# ── First-run admin (optional; created on boot if both set) ───────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Demo resilience / cost control ────────────────────────────────────────
DEMO_MODE=false            # cache outputs, avoid external flakiness for live demos
MOCK_LLM=false             # force deterministic responses (zero LLM spend)
ENABLE_RESUME_VLM=false    # scanned PDFs send page images to provider; explicit opt-in
RESUME_VLM_MAX_PAGES=10
POLICY_CACHE_SIZE=32       # number of recent policy answers to cache
CHAT_POLICY_TIMEOUT_SECONDS=15  # never leave a chat policy lookup pending forever

# ── Safety / observability ────────────────────────────────────────────────
REDACT_PII=true            # mask emails/phones/SSNs/cards before audit + tools
PII_ENGINE=regex           # regex (default) or presidio (NER; needs presidio + spaCy)
CONFIDENCE_THRESHOLD=0.7   # policy answers below this are flagged for human review
LANGSMITH_TRACING=false    # true enables privacy-safe manager/worker CrewAI traces
LANGSMITH_API_KEY=         # inject through environment/secret manager; never commit
LANGSMITH_PROJECT=govern-ai-crewai

# ── RAG / vector search ───────────────────────────────────────────────────
ENABLE_RAG=true            # toggle retrieval (off = always degraded; demo/mock)
VECTOR_BACKEND=auto        # auto (pgvector on Postgres, else Qdrant) | pgvector | qdrant | none
EMBEDDING_PROVIDER=local    # local | fireworks
FIREWORKS_EMBEDDING_MODEL=  # required only when EMBEDDING_PROVIDER=fireworks
FIREWORKS_RESUME_MODEL=     # optional allowlisted structured resume/Gemma model
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=auto       # auto | cpu | cuda; affects local embeddings only
VECTOR_WRITE_BATCH_SIZE=128
ENABLE_GPU_KERNELS=false
GPU_KERNEL_MIN_CORPUS=10000
GPU_KERNEL_MIN_SPEEDUP=1.5
GPU_KERNEL_MEASURED_SPEEDUP=0

# ── Synthetic resume object storage (MinIO/S3) ───────────────────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=hrcc-synthetic-resumes

# ── Consent-gated professional OSINT boundary (disabled by default) ───────
OSINT_ENABLED=false
OSINT_ALLOWED_DOMAINS=github.com,orcid.org
S3_PREFIX=
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
