# ── Core ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_key_here          # optional; omit for deterministic fallback mode
# CLAUDE_MODEL=claude-sonnet-4-20250514  # default; EOL 2026-06-15 — set a current
#                                        # supported model for live use (a current Haiku
#                                        # is a good cheap tier for triage classification)
QDRANT_URL=http://localhost:6333
DATABASE_URL=sqlite:///./hr_command_center.db   # or postgresql://user:pass@host:5432/hrdb
ENVIRONMENT=development

# ── Auth / RBAC ───────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
AUTH_ENFORCE=false                       # true = require auth + enforce roles
AUTH_OPEN_REGISTRATION=true              # first registered user becomes admin
WEBHOOK_SECRET=                          # required header for inbound webhooks in prod

# ── Google OAuth (optional) ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:8000
FRONTEND_BASE=http://localhost:3000

# ── First-run admin (optional; created on boot if both set) ───────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Demo resilience / cost control ────────────────────────────────────────
DEMO_MODE=false            # cache outputs, avoid external flakiness for live demos
MOCK_LLM=false             # force deterministic responses (zero LLM spend)
POLICY_CACHE_SIZE=32       # number of recent policy answers to cache

# ── Safety / observability ────────────────────────────────────────────────
REDACT_PII=true            # mask emails/phones/SSNs/cards before audit + tools
PII_ENGINE=regex           # regex (default) or presidio (NER; needs presidio + spaCy)
CONFIDENCE_THRESHOLD=0.7   # policy answers below this are flagged for human review

# ── RAG / vector search ───────────────────────────────────────────────────
ENABLE_RAG=true            # toggle retrieval (off = always degraded; demo/mock)
VECTOR_BACKEND=auto        # auto (pgvector on Postgres, else Qdrant) | pgvector | qdrant | none
