# Live validation template.
# Copy to backend/.env.local or export these in your shell. Never commit real values.

# Fireworks hosted inference
LLM_PROVIDER=fireworks
FIREWORKS_API_KEY=replace-with-fireworks-key
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
ALLOWED_MODELS=replace-with-exact-fireworks-model-id,replace-with-second-model-id
FIREWORKS_VISION_MODEL=
FIREWORKS_CONTROL_BASE_URL=
FIREWORKS_ACCOUNT_ID=

# AMD-hosted Gemma / vLLM route
# Switch LLM_PROVIDER to amd_vllm only when this endpoint is live and validated.
AMD_VLLM_BASE_URL=http://replace-amd-vllm-host:8000/v1
AMD_VLLM_API_KEY=replace-with-internal-amd-vllm-key
AMD_VLLM_SERVED_MODEL=replace-with-gemma-served-model
AMD_RUNTIME_EVIDENCE_FILE=/tmp/amd-runtime.json
HF_TOKEN=replace-only-in-gpu-runtime-secret

# Safety posture
AUTH_ENFORCE=true
MOCK_LLM=false
DEMO_MODE=false
ENABLE_RAG=true
ENABLE_RESUME_VLM=false
REDACT_PII=true
PII_ENGINE=regex

# First-run admin for testing only. Use a real secret manager outside local smoke.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-long-test-password
