# Production environment — cost & security controls.
# Copy to .env (or set in your platform's secret manager) for a hosted deploy.
# Every flag here is read by core/config.py. The app runs safely with NONE set
# (sensible defaults), so this file is the "lock it down" overlay.

# --- LLM provider ----------------------------------------------------------
LLM_PROVIDER=fireworks         # Submission path: all live calls use Fireworks
MOCK_LLM=false                 # Fireworks mode bypasses this, but keep explicit
DEMO_MODE=false                # Do not force deterministic fallbacks in submission
FIREWORKS_API_KEY=             # Inject via secret manager / harness
FIREWORKS_BASE_URL=            # Inject; do not default to a real host in repo
FIREWORKS_CONTROL_BASE_URL=    # Batch management API base; inject
FIREWORKS_ACCOUNT_ID=          # Batch account; not needed for online inference
FIREWORKS_VISION_MODEL=        # optional; must also appear in ALLOWED_MODELS
ALLOWED_MODELS=                # Inject comma-separated model ids; no hardcoded ids
FIREWORKS_MAX_RETRIES=4        # Short online retry budget; do not hold chat for cold starts
FIREWORKS_SESSION_AFFINITY=true # Hash session IDs for replica-local prompt caching
FIREWORKS_BATCH_TIMEOUT_SECONDS=30
SEMANTIC_CACHE_TTL=3600        # Cache RAG answers for 1h (cuts repeat compute/LLM cost)
POLICY_CACHE_SIZE=64           # How many recent policy answers to keep cached
CHAT_POLICY_TIMEOUT_SECONDS=15 # Bound cold-start/vector-backend stalls
EMBEDDING_BATCH_SIZE=32        # Bounded provider/local embedding requests
EMBEDDING_DEVICE=auto          # auto | cpu | cuda; ignored by Fireworks embeddings
VECTOR_WRITE_BATCH_SIZE=128
ENABLE_GPU_KERNELS=false       # Custom kernels are opt-in after benchmark approval
ENABLE_RESUME_VLM=false        # explicit consent: page images may contain PII
RESUME_VLM_MAX_PAGES=10
GPU_KERNEL_MIN_CORPUS=10000
GPU_KERNEL_MIN_SPEEDUP=1.5
GPU_KERNEL_MEASURED_SPEEDUP=0  # Inject only from named-hardware benchmark evidence

# Optional local Anthropic mode instead of Fireworks:
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-4-20250514
#
# Optional self-hosted AMD/vLLM mode:
# LLM_PROVIDER=amd_vllm
# AMD_VLLM_API_KEY=             # inject through the cluster secret manager
# AMD_VLLM_BASE_URL=            # inject the internal OpenAI-compatible /v1 URL
# ALLOWED_MODELS=               # served names exposed by this deployment only
#   ^ EOL WARNING: the in-code default (claude-sonnet-4-20250514) reaches
#     end-of-life 2026-06-15. For a live deployment, set CLAUDE_MODEL to a
#     current, supported model (verify the exact id against your Anthropic
#     account — do NOT downgrade to an older 3.x model, which is already EOL).
#     A current Haiku is a good cheap-tier choice for triage classification.

# --- Abuse / DoS control ---------------------------------------------------
RATE_LIMIT_REQUESTS=100        # Max requests per IP per window (0 = unlimited)
RATE_LIMIT_WINDOW_SECONDS=3600 # Rolling window for the limiter (1 hour)
MAX_UPLOAD_SIZE_MB=10          # Reject larger PDF uploads (resumes/policies)

# --- Security posture ------------------------------------------------------
AUTH_ENFORCE=true              # Require a valid token; enforce RBAC (no anon viewer)
AUTH_OPEN_REGISTRATION=false   # No self-signup; admin provisions accounts
JWT_SECRET=change-me-to-a-long-random-string   # MUST override the dev default
REDACT_PII=true                # Redact emails/phones/SSNs/cards before any write
# ADMIN_EMAIL=you@org.com      # First-run admin created on boot (with ADMIN_PASSWORD)
# ADMIN_PASSWORD=...

# --- Data store ------------------------------------------------------------
# Use Postgres in production (enables pgvector for real semantic search).
# DATABASE_URL=postgresql://hr:password@db:5432/hrdb
ENVIRONMENT=production
