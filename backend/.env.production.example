# Production environment — cost & security controls.
# Copy to .env (or set in your platform's secret manager) for a hosted deploy.
# Every flag here is read by core/config.py. The app runs safely with NONE set
# (sensible defaults), so this file is the "lock it down" overlay.

# --- Cost control ----------------------------------------------------------
MOCK_LLM=true                  # No Anthropic API calls — deterministic answers, $0 LLM spend
DEMO_MODE=true                 # Force fallbacks + answer caching, no external flakiness
SEMANTIC_CACHE_TTL=3600        # Cache RAG answers for 1h (cuts repeat compute/LLM cost)
POLICY_CACHE_SIZE=64           # How many recent policy answers to keep cached

# Flip these for a real (paid) LLM deployment instead:
# MOCK_LLM=false
# DEMO_MODE=false
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-4-20250514
#   ^ EOL WARNING: the in-code default (claude-sonnet-4-20250514) reaches
#     end-of-life 2026-06-15. For a live deployment, set CLAUDE_MODEL to a
#     current, supported model (verify the exact id against your Anthropic
#     account — do NOT downgrade to an older 3.x model, which is already EOL).
#     A current Haiku is a good cheap-tier choice for triage classification.

# --- Abuse / DoS control ---------------------------------------------------
RATE_LIMIT_REQUESTS=100        # Max requests per IP per window (0 = unlimited)
RATE_LIMIT_WINDOW_SECONDS=3600 # Rolling window for the limiter (1 hour)
MAX_UPLOAD_SIZE_MB=10          # Reject larger PDF uploads (resumes/policies)

# --- Security posture ------------------------------------------------------
AUTH_ENFORCE=true              # Require a valid token; enforce RBAC (no anon viewer)
AUTH_OPEN_REGISTRATION=false   # No self-signup; admin provisions accounts
JWT_SECRET=change-me-to-a-long-random-string   # MUST override the dev default
REDACT_PII=true                # Redact emails/phones/SSNs/cards before any write
# ADMIN_EMAIL=you@org.com      # First-run admin created on boot (with ADMIN_PASSWORD)
# ADMIN_PASSWORD=...

# --- Data store ------------------------------------------------------------
# Use Postgres in production (enables pgvector for real semantic search).
# DATABASE_URL=postgresql://hr:password@db:5432/hrdb
ENVIRONMENT=production
