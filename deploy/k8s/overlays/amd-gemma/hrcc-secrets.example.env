# Copy this file outside git, replace placeholder values, then create the secret:
#
#   kubectl apply -f deploy/k8s/base/namespace.yaml
#   kubectl -n hr-ai-system create secret generic hrcc-secrets \
#     --from-env-file=deploy/k8s/overlays/amd-gemma/hrcc-secrets.real.env
#
# Application/backend secret. GPU-only model IDs and the Hugging Face token live
# in hrcc-gpu-secrets.example.env so the backend never receives weight-download
# credentials through envFrom.
# Do not commit real keys.

AMD_VLLM_API_KEY=replace-with-random-internal-vllm-api-key
ALLOWED_MODELS=amd-gemma-3-27b-it
JWT_SECRET=replace-with-long-random-jwt-secret
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=replace-with-strong-first-run-admin-password
DATABASE_URL=postgresql://hr:replace-password@postgresql.example.internal:5432/hrdb
