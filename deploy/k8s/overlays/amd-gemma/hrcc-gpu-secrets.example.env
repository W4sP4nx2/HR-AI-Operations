# a read-scoped Hugging Face token. Do not commit the real token.
#
#   kubectl -n hr-ai-system create secret generic hrcc-gpu-secrets \
#     --from-env-file=deploy/k8s/overlays/amd-gemma/hrcc-gpu-secrets.real.env

GPU_MODEL_ID=google/gemma-3-27b-it
GPU_SERVED_MODEL_NAME=amd-gemma-3-27b-it
HF_TOKEN=replace-after-accepting-the-gemma-license
